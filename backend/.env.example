# Hub backend environment. Copy to .env (git-ignored) for development, or set these in your process manager / secret store.
# Go does not read this file by itself: `set -a; source .env; set +a` (./dev.sh does this).
# REQUIRED IN PRODUCTION = the server refuses to start without it. Generate the secrets with scripts/gen-keys.sh, once.

# --- Environment -------------------------------------------------------------------------------------------------------------
HUB_ENV=dev                                  # dev | staging | prod
HUB_DOCS_ENVS=dev,staging,prod               # environments that serve the API reference at /v1/docs
HUB_HTTP_ADDR=:8080                          # the API
HUB_CALLS_ADDR=:8090                         # the calls (signalling) service
HUB_CALLS_URL=http://127.0.0.1:8090          # where the API reaches calls services (comma-separated list)
# TURN relay, so calls connect across different networks, mobile data and strict firewalls (STUN alone fails for many people).
# A hosted one (metered.ca, Twilio, Cloudflare) gives a fixed user name and password; your own coturn gives a shared secret.
HUB_TURN_URLS=turn:global.relay.metered.ca:80                               # turn:host:80,turn:host:443?transport=tcp,turns:host:443?transport=tcp
HUB_TURN_USER=
HUB_TURN_PASS=
HUB_TURN_SECRET=
HUB_ALLOWED_ORIGINS=http://localhost:3000    # the frontend's address(es), comma-separated. REQUIRED IN PRODUCTION (your real site)
HUB_TRUSTED_PROXIES=127.0.0.0/8,::1/128      # proxies whose X-Forwarded-For is believed (your load balancer's range in production)

# --- Database and Redis ------------------------------------------------------------------------------------------------------
HUB_DATABASE_URL=postgres://hub_app:...@127.0.0.1:5433/hub?sslmode=disable       # REQUIRED. The application role. sslmode=verify-full in production
HUB_MIGRATE_URL=postgres://hub_owner:...@127.0.0.1:5433/hub?sslmode=disable      # REQUIRED for migrations and bootstrap. The owner role
HUB_AUDIT_URL=postgres://hub_audit:...@127.0.0.1:5433/hub?sslmode=disable        # the read-only role for the integrity check
# HUB_REDIS=off                              # no Redis server: an in-memory one runs inside the process (one instance only)
HUB_REDIS_ADDR=127.0.0.1:6390                # REQUIRED
HUB_REDIS_PASS=

# --- Secrets (REQUIRED IN PRODUCTION; development derives throwaway ones). 32 bytes, base64, each different. Never change later. ---
HUB_KEK=
HUB_BLIND_KEY=
HUB_MAC_KEY=
HUB_TOKEN_KEY=
HUB_LEDGER_KEY=
HUB_CALLS_SECRET=
HUB_DB_GUARD=                                # REQUIRED IN PRODUCTION: any long random string (scripts/gen-keys.sh)
HUB_METRICS_TOKEN=                           # bearer token for /metrics; when empty only loopback can read it

# --- Email (without HUB_MAIL_API or HUB_SMTP_HOST, messages stay in memory: reset codes never arrive) -------------------
# Render's free instances block every SMTP port: use a web API there (brevo or resend).
HUB_MAIL_API=                                # brevo | resend
HUB_MAIL_API_KEY=
HUB_MAIL_FROM=                               # an address the service has verified for you
HUB_MAIL_FROM_NAME=Hub
# Or SMTP (on your own computer or a paid host):
HUB_SMTP_HOST=
HUB_SMTP_PORT=587
HUB_SMTP_USER=
HUB_SMTP_PASS=
HUB_SMTP_FROM=
HUB_SMTP_FROM_NAME=Hub
HUB_SMTP_SECURITY=starttls                   # starttls | tls | none
HUB_ALLOWED_EMAIL_DOMAINS=                   # optional: only these work-email domains may sign up (comma-separated)

# --- Files -------------------------------------------------------------------------------------------------------------------
HUB_BLOB_DIR=./data/blobs                    # local disk for encrypted files when no file server is set
HUB_FILE_SERVERS=                            # s3://KEY:SECRET@host/bucket?region=..  (space separated, tried in order)
HUB_MAX_UPLOAD=104857600                     # bytes of ciphertext per file

# --- Calls: media servers and limits ---------------------------------------------------------------------------------------
HUB_SFU_NODES=                               # https://media.example.com|APIKEY|SECRET  (comma-separated; empty = small peer-to-peer rooms only)
HUB_CALL_MAX_VOICE=800
HUB_CALL_MAX_VIDEO=800
HUB_CALL_OPEN_MIC=25
HUB_CALL_STAGE=25
HUB_CALL_ROOMS_ORG=100
HUB_CALL_ROOMS_TOTAL=100000

# --- Limits and sessions -----------------------------------------------------------------------------------------------------
HUB_ACCESS_TTL=15m
HUB_REFRESH_TTL=720h
HUB_RATE_IP=600                              # requests a minute from one address
HUB_RATE_AUTH_IP=30                          # a minute from one address on sign-in, sign-up, reset and invite routes
HUB_RATE_ACCT_MIN=1200                       # a minute for one signed-in account
HUB_INTEGRITY_EVERY=                         # e.g. 1h: the worker runs the tamper check this often (needs HUB_AUDIT_URL)

# --- First setup (read by `go run ./cmd/bootstrap owner`) ------------------------------------------------------------------
HUB_OWNER_NAME=
HUB_OWNER_EMAIL=
HUB_ORG_NAME=
HUB_ORG_SLUG=
# HUB_OWNER_PASSWORD=                        # leave unset: a readable one is generated and shown once

# Accounts kept in place on every start (active, in the organization, with that role): "email|name|password|role; email|..."
# HUB_SEED_USERS=

# --- Development helpers only (the database role passwords scripts/bootstrap_db.sh uses) ------------------------------------
# HUB_OWNER_PW=  HUB_APP_PW=  HUB_AUDIT_PW=  HUB_DBA_PW=
