# Production environment for the API, worker and calls service (copy to /etc/hub/hub.env, mode 0600, owned by the service user).
HUB_ENV=prod
HUB_HTTP_ADDR=:8080
HUB_ALLOWED_ORIGINS=https://app.example.com
HUB_TRUSTED_PROXIES=10.0.0.0/8            # your load balancer's addresses: X-Forwarded-For is believed only from these
HUB_DOCS_ENVS=dev,staging,prod
HUB_METRICS_TOKEN=change-me-long-random
# Database: sslmode=verify-full, three different roles (app, owner for migrations, audit read-only)
HUB_DATABASE_URL=postgres://hub_app:...@db.internal:5432/hub?sslmode=verify-full
HUB_MIGRATE_URL=postgres://hub_owner:...@db.internal:5432/hub?sslmode=verify-full
HUB_AUDIT_URL=postgres://hub_audit:...@db.internal:5432/hub?sslmode=verify-full
HUB_REDIS_ADDR=redis.internal:6379
HUB_REDIS_PASS=...
# 32-byte base64 keys, each different, from your KMS (openssl rand -base64 32)
HUB_KEK=
HUB_MAC_KEY=
HUB_BLIND_KEY=
HUB_TOKEN_KEY=
HUB_LEDGER_KEY=
HUB_CALLS_SECRET=
HUB_DB_GUARD=
# Calls: media servers and limits
HUB_CALLS_URL=http://calls-1.internal:8090,http://calls-2.internal:8090
HUB_SFU_NODES=https://media-eu.example.com|APIKEY|SECRET,https://media-af.example.com|APIKEY|SECRET
HUB_CALL_MAX_VOICE=800
HUB_CALL_MAX_VIDEO=800
HUB_CALL_ROOMS_ORG=100
# Files: S3-compatible storage with encryption at rest (the contents are already end-to-end encrypted)
HUB_FILE_SERVERS=s3://KEY:SECRET@s3.example.com/hub-files?region=eu-west-1
