# NewGen Hub Environment Variables

# API Configuration
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001
NUXT_PUBLIC_API_TIMEOUT=30000

# App Configuration
NUXT_PUBLIC_APP_NAME=NewGen Hub
NUXT_PUBLIC_APP_VERSION=1.0.0

# Theme
NUXT_PUBLIC_DEFAULT_THEME=dark

# Feature Flags
NUXT_PUBLIC_ENABLE_WIDGETS=true
NUXT_PUBLIC_ENABLE_DARK_MODE=true
NUXT_PUBLIC_ENABLE_ANALYTICS=false

# Development
NUXT_DEBUG=false
