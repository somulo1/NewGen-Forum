# Hub frontend environment. Copy to .env (git-ignored) for development, or set these when you build/run for production.
# Only variables that start with NUXT_PUBLIC_ reach the browser, so never put a secret here.

# Where the backend API is (no trailing slash). REQUIRED IN PRODUCTION: the real API address, e.g. https://api.example.com.
# It must be listed in the backend's HUB_ALLOWED_ORIGINS the other way round: the backend allows THIS site's address.
NUXT_PUBLIC_API_BASE=http://localhost:8080
