# Copy to .env and fill in; .env is not committed. Both addresses must be https.
# The Hub web site people open in a browser; the app shows its phone layout.
EXPO_PUBLIC_HUB_WEB_URL=https://your-hub-site.example.com
# The Hub backend (API) that site talks to.
EXPO_PUBLIC_HUB_API_URL=https://your-hub-api.example.com

# Push notifications (read at build time only, never put into the app's code).
# The Firebase file for Android pushes (Firebase console > Android app com.newgen.hub). Until it exists the app builds without
# pushes. On EAS, upload it as the GOOGLE_SERVICES_JSON file secret instead.
GOOGLE_SERVICES_JSON=./google-services.json
# Apple push environment for iPhone builds: production (store/TestFlight) or development (development builds).
HUB_APS_ENV=production
